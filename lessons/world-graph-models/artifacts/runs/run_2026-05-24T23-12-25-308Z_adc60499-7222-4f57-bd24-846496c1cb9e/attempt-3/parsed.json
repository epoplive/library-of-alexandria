          }
        ]
      },
      "duration_estimate_s": 10,
      "kind": "narrator-opener",
      "scene_eyebrow": "Equivariance",
      "scene_title": "Order Does Not Matter",
      "shot_address": {
        "scene_id": "scene-order-does-not-matter",
        "shot_id": "shot-7-1"
      },
      "source_beat_id": "beat-order-does-not-matter-01",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-028aff37b8904164",
          "cast_id": "narrator",
          "id": "line-shot-7-1-1",
          "source_sentence_ids": [
            "028aff37b8904164"
          ],
          "text": "Object slots and graph nodes often arrive in an arbitrary order."
        },
        {
          "audio_slot_id": "audio-pending-3b5d89feda8f41a6",
          "cast_id": "narrator",
          "id": "line-shot-7-1-2",
          "source_sentence_ids": [
            "3b5d89feda8f41a6"
          ],
          "text": "If two identical descriptions are listed in a different order, the world has not physically changed."
        }
      ],
      "transition_in": {
        "duration_ms": 600,
        "kind": "cross-dissolve"
      }
    },
    {
      "duration_estimate_s": 11,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-order-does-not-matter",
        "shot_id": "shot-7-2"
      },
      "source_beat_id": "beat-order-does-not-matter-02",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-3339b73b08d12087",
          "cast_id": "narrator",
          "id": "line-shot-7-2-1",
          "source_sentence_ids": [
            "3339b73b08d12087"
          ],
          "text": "A permutation-equivariant graph model respects that fact by moving predictions with the reordered labels."
        },
        {
          "audio_slot_id": "audio-pending-1b28307ebed8d60f",
          "cast_id": "narrator",
          "id": "line-shot-7-2-2",
          "source_sentence_ids": [
            "1b28307ebed8d60f"
          ],
          "text": "It should not predict a different collision merely because object three was renamed object one."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 3,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-order-does-not-matter",
        "shot_id": "shot-7-3"
      },
      "source_beat_id": "beat-order-does-not-matter-03",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-b6b08b2e87f04a9e",
          "cast_id": "narrator",
          "id": "line-shot-7-3-1",
          "source_sentence_ids": [
            "b6b08b2e87f04a9e"
          ],
          "text": "Order does not matter, but consistent correspondence does."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "background_intent": {
        "kind": "gradient",
        "stops": [
          {
            "color": "#0f172a",
            "offset": 0
          },
          {
            "color": "#16a34a",
            "offset": 1
          }
        ]
      },
      "duration_estimate_s": 5,
      "kind": "narrator-opener",
      "scene_eyebrow": "Structure From Perception",
      "scene_title": "Learning The Slots",
      "shot_address": {
        "scene_id": "scene-learning-the-slots",
        "shot_id": "shot-8-1"
      },
      "source_beat_id": "beat-learning-the-slots-01",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-9e981a90f496937d",
          "cast_id": "narrator",
          "id": "line-shot-8-1-1",
          "source_sentence_ids": [
            "9e981a90f496937d"
          ],
          "text": "An object-centric world model first has to find the objects before it can reason over them."
        }
      ],
      "transition_in": {
        "duration_ms": 600,
        "kind": "cross-dissolve"
      }
    },
    {
      "duration_estimate_s": 11,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-learning-the-slots",
        "shot_id": "shot-8-2"
      },
      "source_beat_id": "beat-learning-the-slots-02",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-b90944412880b6a7",
          "cast_id": "narrator",
          "id": "line-shot-8-2-1",
          "source_sentence_ids": [
            "b90944412880b6a7"
          ],
          "text": "Slot attention offers one route by assigning parts of an observation to a small set of latent slots."
        },
        {
          "audio_slot_id": "audio-pending-404a5ca0fb41382c",
          "cast_id": "narrator",
          "id": "line-shot-8-2-2",
          "source_sentence_ids": [
            "404a5ca0fb41382c"
          ],
          "text": "Those slots can become graph nodes whose relations are updated by a latent GNN dynamics model."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 6,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-learning-the-slots",
        "shot_id": "shot-8-3"
      },
      "source_beat_id": "beat-learning-the-slots-03",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-e6fe9fcdd847bea0",
          "cast_id": "narrator",
          "id": "line-shot-8-3-1",
          "source_sentence_ids": [
            "e6fe9fcdd847bea0"
          ],
          "text": "The pipeline separates perception from simulation without requiring the final state to be a single monolithic vector."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 6,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-learning-the-slots",
        "shot_id": "shot-8-4"
      },
      "source_beat_id": "beat-learning-the-slots-04",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-dcee0c28b5a0df6c",
          "cast_id": "narrator",
          "id": "line-shot-8-4-1",
          "source_sentence_ids": [
            "dcee0c28b5a0df6c"
          ],
          "text": "Its promise is a world model that can discover entities from observations and then predict their interactions."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "background_intent": {
        "kind": "gradient",
        "stops": [
          {
            "color": "#111827",
            "offset": 0
          },
          {
            "color": "#db2777",
            "offset": 1
          }
        ]
      },
      "duration_estimate_s": 4,
      "kind": "narrator-opener",
      "scene_eyebrow": "Objective Choice",
      "scene_title": "What To Train For",
      "shot_address": {
        "scene_id": "scene-what-to-train-for",
        "shot_id": "shot-9-1"
      },
      "source_beat_id": "beat-what-to-train-for-01",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-624e07e5de5ae99b",
          "cast_id": "narrator",
          "id": "line-shot-9-1-1",
          "source_sentence_ids": [
            "624e07e5de5ae99b"
          ],
          "text": "A training objective decides what the latent graph is pressured to remember."
        }
      ],
      "transition_in": {
        "duration_ms": 600,
        "kind": "cross-dissolve"
      }
    },
    {
      "duration_estimate_s": 11,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-what-to-train-for",
        "shot_id": "shot-9-2"
      },
      "source_beat_id": "beat-what-to-train-for-02",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-05e18b8a9c57d3f1",
          "cast_id": "narrator",
          "id": "line-shot-9-2-1",
          "source_sentence_ids": [
            "05e18b8a9c57d3f1"
          ],
          "text": "A reconstruction loss rewards states that can rebuild observations, including details that may not matter for control."
        },
        {
          "audio_slot_id": "audio-pending-3e43d435556ee587",
          "cast_id": "narrator",
          "id": "line-shot-9-2-2",
          "source_sentence_ids": [
            "3e43d435556ee587"
          ],
          "text": "A contrastive objective can instead reward distinctions between plausible and implausible future states."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 7,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-what-to-train-for",
        "shot_id": "shot-9-3"
      },
      "source_beat_id": "beat-what-to-train-for-03",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-9549bcec44cb97fc",
          "cast_id": "narrator",
          "id": "line-shot-9-3-1",
          "source_sentence_ids": [
            "9549bcec44cb97fc"
          ],
          "text": "For graph world models, that difference shapes whether the representation preserves pixels, controllable factors, or relational structure."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 6,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-what-to-train-for",
        "shot_id": "shot-9-4"
      },
      "source_beat_id": "beat-what-to-train-for-04",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-5f53d0816077ea4e",
          "cast_id": "narrator",
          "id": "line-shot-9-4-1",
          "source_sentence_ids": [
            "5f53d0816077ea4e"
          ],
          "text": "The right objective depends on whether the learner needs faithful reconstruction, useful planning features, or robust generalization."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "background_intent": {
        "kind": "gradient",
        "stops": [
          {
            "color": "#020617",
            "offset": 0
          },
          {
            "color": "#4f46e5",
            "offset": 1
          }
        ]
      },
      "duration_estimate_s": 6,
      "kind": "narrator-opener",
      "scene_eyebrow": "Planning Returns",
      "scene_title": "Search In The Graph",
      "shot_address": {
        "scene_id": "scene-search-in-the-graph",
        "shot_id": "shot-10-1"
      },
      "source_beat_id": "beat-search-in-the-graph-01",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-78de42b71f2e4963",
          "cast_id": "narrator",
          "id": "line-shot-10-1-1",
          "source_sentence_ids": [
            "78de42b71f2e4963"
          ],
          "text": "Once a graph latent can predict future states, planning can search through possible actions inside that learned space."
        }
      ],
      "transition_in": {
        "duration_ms": 600,
        "kind": "cross-dissolve"
      }
    },
    {
      "duration_estimate_s": 12,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-search-in-the-graph",
        "shot_id": "shot-10-2"
      },
      "source_beat_id": "beat-search-in-the-graph-02",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-525ea2455dbe408f",
          "cast_id": "narrator",
          "id": "line-shot-10-2-1",
          "source_sentence_ids": [
            "525ea2455dbe408f"
          ],
          "text": "Model predictive control samples or optimizes short action sequences, scores their predicted futures, and executes the first action."
        },
        {
          "audio_slot_id": "audio-pending-7f6b42c97af45f66",
          "cast_id": "narrator",
          "id": "line-shot-10-2-2",
          "source_sentence_ids": [
            "7f6b42c97af45f66"
          ],
          "text": "Heuristic search adds guidance about which futures look promising before all branches are expanded."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 7,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-search-in-the-graph",
        "shot_id": "shot-10-3"
      },
      "source_beat_id": "beat-search-in-the-graph-03",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-ddea06de9985a1c1",
          "cast_id": "narrator",
          "id": "line-shot-10-3-1",
          "source_sentence_ids": [
            "ddea06de9985a1c1"
          ],
          "text": "Monte Carlo tree search builds a tree of imagined graph states and uses repeated evaluations to choose the next move."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 7,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-search-in-the-graph",
        "shot_id": "shot-10-4"
      },
      "source_beat_id": "beat-search-in-the-graph-04",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-3c9561be2638b27c",
          "cast_id": "narrator",
          "id": "line-shot-10-4-1",
          "source_sentence_ids": [
            "3c9561be2638b27c"
          ],
          "text": "All of these methods trade policy commitment for on-demand reasoning, while still paying the cost of model error and branching choices."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "background_intent": {
        "kind": "gradient",
        "stops": [
          {
            "color": "#111827",
            "offset": 0
          },
          {
            "color": "#0ea5e9",
            "offset": 1
          }
        ]
      },
      "duration_estimate_s": 5,
      "kind": "narrator-opener",
      "scene_eyebrow": "Synthesis",
      "scene_title": "Connector Simulator Reasoner",
      "shot_address": {
        "scene_id": "scene-connector-simulator-reasoner",
        "shot_id": "shot-11-1"
      },
      "source_beat_id": "beat-connector-simulator-reasoner-01",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-85bb5871f0f2fee0",
          "cast_id": "narrator",
          "id": "line-shot-11-1-1",
          "source_sentence_ids": [
            "85bb5871f0f2fee0"
          ],
          "text": "By the end of the lesson, the graph has played three roles in the world model story."
        }
      ],
      "transition_in": {
        "duration_ms": 600,
        "kind": "cross-dissolve"
      }
    },
    {
      "duration_estimate_s": 10,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-connector-simulator-reasoner",
        "shot_id": "shot-11-2"
      },
      "source_beat_id": "beat-connector-simulator-reasoner-02",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-954c567039702046",
          "cast_id": "narrator",
          "id": "line-shot-11-2-1",
          "source_sentence_ids": [
            "954c567039702046"
          ],
          "text": "As connector, it names entities and relations so multi-object scenes can be represented compositionally."
        },
        {
          "audio_slot_id": "audio-pending-485116bfb39852fc",
          "cast_id": "narrator",
          "id": "line-shot-11-2-2",
          "source_sentence_ids": [
            "485116bfb39852fc"
          ],
          "text": "As simulator, it uses message passing to update object states under actions."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 5,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-connector-simulator-reasoner",
        "shot_id": "shot-11-3"
      },
      "source_beat_id": "beat-connector-simulator-reasoner-03",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-f9eea99e2d37a140",
          "cast_id": "narrator",
          "id": "line-shot-11-3-1",
          "source_sentence_ids": [
            "f9eea99e2d37a140"
          ],
          "text": "As reasoner, it gives planners a structured space for comparing possible futures."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 8,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-connector-simulator-reasoner",
        "shot_id": "shot-11-4"
      },
      "source_beat_id": "beat-connector-simulator-reasoner-04",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-12a833a7ac4f8388",
          "cast_id": "narrator",
          "id": "line-shot-11-4-1",
          "source_sentence_ids": [
            "12a833a7ac4f8388"
          ],
          "text": "Each role introduces a tradeoff: stronger structure can improve generalization, but only when the learned entities, edges, and objectives match the task."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    }
  ],
  "schema_version": "loa.storyboard.v1"
}