          }
        ]
      },
      "duration_estimate_s": 7,
      "kind": "narrator-opener",
      "scene_eyebrow": "Opening Question",
      "scene_title": "Model Before Policy",
      "shot_address": {
        "scene_id": "scene-model-before-policy",
        "shot_id": "shot-1-1"
      },
      "source_beat_id": "beat-model-before-policy-01",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-b9880e9b08f54375",
          "cast_id": "narrator",
          "id": "line-shot-1-1-1",
          "source_sentence_ids": [
            "b9880e9b08f54375"
          ],
          "text": "A reinforcement learning agent normally pays for knowledge with real trials, one action and one consequence at a time."
        }
      ]
    },
    {
      "duration_estimate_s": 12,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-model-before-policy",
        "shot_id": "shot-1-2"
      },
      "source_beat_id": "beat-model-before-policy-02",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-39d5f0693bab3457",
          "cast_id": "narrator",
          "id": "line-shot-1-2-1",
          "source_sentence_ids": [
            "39d5f0693bab3457"
          ],
          "text": "A learned world model changes that bargain by turning past experience into a simulator of what might happen next."
        },
        {
          "audio_slot_id": "audio-pending-a81ca8e619ba66e8",
          "cast_id": "narrator",
          "id": "line-shot-1-2-2",
          "source_sentence_ids": [
            "a81ca8e619ba66e8"
          ],
          "text": "The agent can ask the model for imagined transitions before it commits to another action in the environment."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 13,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-model-before-policy",
        "shot_id": "shot-1-3"
      },
      "source_beat_id": "beat-model-before-policy-03",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-4f037fc5db31a287",
          "cast_id": "narrator",
          "id": "line-shot-1-3-1",
          "source_sentence_ids": [
            "4f037fc5db31a287"
          ],
          "text": "Sample efficiency improves when useful policy updates come from both real interaction and predicted experience."
        },
        {
          "audio_slot_id": "audio-pending-daf01f6c4d2192ce",
          "cast_id": "narrator",
          "id": "line-shot-1-3-2",
          "source_sentence_ids": [
            "daf01f6c4d2192ce"
          ],
          "text": "The opening question is not whether the model is perfect, but whether it is good enough to make real trials count for more."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "background_intent": {
        "kind": "gradient",
        "stops": [
          {
            "color": "#111827",
            "offset": 0
          },
          {
            "color": "#0891b2",
            "offset": 1
          }
        ]
      },
      "duration_estimate_s": 5,
      "kind": "narrator-opener",
      "scene_eyebrow": "Latent Imagination",
      "scene_title": "Dream Space",
      "shot_address": {
        "scene_id": "scene-dream-space",
        "shot_id": "shot-2-1"
      },
      "source_beat_id": "beat-dream-space-01",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-ac090a786eb2c74d",
          "cast_id": "narrator",
          "id": "line-shot-2-1-1",
          "source_sentence_ids": [
            "ac090a786eb2c74d"
          ],
          "text": "A latent world model does not need to store every pixel as the agent sees it."
        }
      ],
      "transition_in": {
        "duration_ms": 600,
        "kind": "cross-dissolve"
      }
    },
    {
      "duration_estimate_s": 11,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-dream-space",
        "shot_id": "shot-2-2"
      },
      "source_beat_id": "beat-dream-space-02",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-de8b6f0a6c5a5ee6",
          "cast_id": "narrator",
          "id": "line-shot-2-2-1",
          "source_sentence_ids": [
            "de8b6f0a6c5a5ee6"
          ],
          "text": "It learns a compact state that keeps the information needed to predict rewards, observations, and consequences of actions."
        },
        {
          "audio_slot_id": "audio-pending-3f056baf1756b3df",
          "cast_id": "narrator",
          "id": "line-shot-2-2-2",
          "source_sentence_ids": [
            "3f056baf1756b3df"
          ],
          "text": "Inside that compressed space, rollout steps are cheaper than replaying the full world in detail."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 7,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-dream-space",
        "shot_id": "shot-2-3"
      },
      "source_beat_id": "beat-dream-space-03",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-e8754f50ce774194",
          "cast_id": "narrator",
          "id": "line-shot-2-3-1",
          "source_sentence_ids": [
            "e8754f50ce774194"
          ],
          "text": "A policy can train inside those predicted futures and test many action sequences before touching the real environment again."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 5,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-dream-space",
        "shot_id": "shot-2-4"
      },
      "source_beat_id": "beat-dream-space-04",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-34422d701b866cd0",
          "cast_id": "narrator",
          "id": "line-shot-2-4-1",
          "source_sentence_ids": [
            "34422d701b866cd0"
          ],
          "text": "Latent imagination is useful because it makes planning and policy learning fast enough to repeat."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "background_intent": {
        "kind": "gradient",
        "stops": [
          {
            "color": "#18181b",
            "offset": 0
          },
          {
            "color": "#dc2626",
            "offset": 1
          }
        ]
      },
      "duration_estimate_s": 4,
      "kind": "narrator-opener",
      "scene_eyebrow": "Failure Mode",
      "scene_title": "Error Horizon",
      "shot_address": {
        "scene_id": "scene-error-horizon",
        "shot_id": "shot-3-1"
      },
      "source_beat_id": "beat-error-horizon-01",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-8a7e1525f87236ec",
          "cast_id": "narrator",
          "id": "line-shot-3-1-1",
          "source_sentence_ids": [
            "8a7e1525f87236ec"
          ],
          "text": "The same imagination that saves samples also creates a new failure mode."
        }
      ],
      "transition_in": {
        "duration_ms": 600,
        "kind": "cross-dissolve"
      }
    },
    {
      "duration_estimate_s": 14,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-error-horizon",
        "shot_id": "shot-3-2"
      },
      "source_beat_id": "beat-error-horizon-02",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-234b1b4219a0d0f0",
          "cast_id": "narrator",
          "id": "line-shot-3-2-1",
          "source_sentence_ids": [
            "234b1b4219a0d0f0"
          ],
          "text": "A one-step prediction can look accurate while still carrying a small error in position, reward, or hidden state."
        },
        {
          "audio_slot_id": "audio-pending-b48739eead614cf7",
          "cast_id": "narrator",
          "id": "line-shot-3-2-2",
          "source_sentence_ids": [
            "b48739eead614cf7"
          ],
          "text": "When the model feeds its own prediction into the next prediction, that small miss can become the starting point for a larger miss."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 5,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-error-horizon",
        "shot_id": "shot-3-3"
      },
      "source_beat_id": "beat-error-horizon-03",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-945a45d42f124856",
          "cast_id": "narrator",
          "id": "line-shot-3-3-1",
          "source_sentence_ids": [
            "945a45d42f124856"
          ],
          "text": "Long imagined rollouts therefore have an error horizon where useful forecasts fade into model fantasy."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 6,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-error-horizon",
        "shot_id": "shot-3-4"
      },
      "source_beat_id": "beat-error-horizon-04",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-fd2eb5862ba7790e",
          "cast_id": "narrator",
          "id": "line-shot-3-4-1",
          "source_sentence_ids": [
            "fd2eb5862ba7790e"
          ],
          "text": "Good model-based control must balance the value of looking ahead against the risk of trusting predictions too far."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "background_intent": {
        "kind": "gradient",
        "stops": [
          {
            "color": "#0c0a09",
            "offset": 0
          },
          {
            "color": "#059669",
            "offset": 1
          }
        ]
      },
      "duration_estimate_s": 7,
      "kind": "narrator-opener",
      "scene_eyebrow": "Object Worlds",
      "scene_title": "The Combinatorial Wall",
      "shot_address": {
        "scene_id": "scene-combinatorial-wall",
        "shot_id": "shot-4-1"
      },
      "source_beat_id": "beat-combinatorial-wall-01",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-aee1c79da73eb49b",
          "cast_id": "narrator",
          "id": "line-shot-4-1-1",
          "source_sentence_ids": [
            "aee1c79da73eb49b"
          ],
          "text": "A single-vector latent state can summarize a scene, but it does not naturally say which part belongs to which object."
        }
      ],
      "transition_in": {
        "duration_ms": 600,
        "kind": "cross-dissolve"
      }
    },
    {
      "duration_estimate_s": 11,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-combinatorial-wall",
        "shot_id": "shot-4-2"
      },
      "source_beat_id": "beat-combinatorial-wall-02",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-8f56dcd274cad430",
          "cast_id": "narrator",
          "id": "line-shot-4-2-1",
          "source_sentence_ids": [
            "8f56dcd274cad430"
          ],
          "text": "As the number of objects grows, the possible arrangements and interactions grow much faster than the training set."
        },
        {
          "audio_slot_id": "audio-pending-b290d66327718ef9",
          "cast_id": "narrator",
          "id": "line-shot-4-2-2",
          "source_sentence_ids": [
            "b290d66327718ef9"
          ],
          "text": "An object-centric representation breaks the scene into reusable entities with their own attributes."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 6,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-combinatorial-wall",
        "shot_id": "shot-4-3"
      },
      "source_beat_id": "beat-combinatorial-wall-03",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-8ba2cecf87512e78",
          "cast_id": "narrator",
          "id": "line-shot-4-3-1",
          "source_sentence_ids": [
            "8ba2cecf87512e78"
          ],
          "text": "The model can then ask how these entities relate instead of relearning every whole-scene configuration from scratch."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 5,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-combinatorial-wall",
        "shot_id": "shot-4-4"
      },
      "source_beat_id": "beat-combinatorial-wall-04",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-2b568ae74c33ebaf",
          "cast_id": "narrator",
          "id": "line-shot-4-4-1",
          "source_sentence_ids": [
            "2b568ae74c33ebaf"
          ],
          "text": "This is the combinatorial wall that pushes world models toward objects and relations."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "background_intent": {
        "kind": "gradient",
        "stops": [
          {
            "color": "#111827",
            "offset": 0
          },
          {
            "color": "#7c3aed",
            "offset": 1
          }
        ]
      },
      "duration_estimate_s": 6,
      "kind": "narrator-opener",
      "scene_eyebrow": "Graph Assumption",
      "scene_title": "Relational Bias",
      "shot_address": {
        "scene_id": "scene-relational-bias",
        "shot_id": "shot-5-1"
      },
      "source_beat_id": "beat-relational-bias-01",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-1fcfa4ce83be9fd9",
          "cast_id": "narrator",
          "id": "line-shot-5-1-1",
          "source_sentence_ids": [
            "1fcfa4ce83be9fd9"
          ],
          "text": "A graph builds an assumption into the model: entities are nodes, and possible influences are edges."
        }
      ],
      "transition_in": {
        "duration_ms": 600,
        "kind": "cross-dissolve"
      }
    },
    {
      "duration_estimate_s": 13,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-relational-bias",
        "shot_id": "shot-5-2"
      },
      "source_beat_id": "beat-relational-bias-02",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-9a89ba2c429c44db",
          "cast_id": "narrator",
          "id": "line-shot-5-2-1",
          "source_sentence_ids": [
            "9a89ba2c429c44db"
          ],
          "text": "The same update rule can be shared across many pairs of objects instead of being tied to one fixed scene layout."
        },
        {
          "audio_slot_id": "audio-pending-f174f2ecc4d9cd87",
          "cast_id": "narrator",
          "id": "line-shot-5-2-2",
          "source_sentence_ids": [
            "f174f2ecc4d9cd87"
          ],
          "text": "That relational inductive bias helps the model reuse a learned interaction when the objects are rearranged or the count changes."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 10,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-relational-bias",
        "shot_id": "shot-5-3"
      },
      "source_beat_id": "beat-relational-bias-03",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-35f100d4f1512217",
          "cast_id": "narrator",
          "id": "line-shot-5-3-1",
          "source_sentence_ids": [
            "35f100d4f1512217"
          ],
          "text": "Generalization comes from treating relations as repeatable structure, not as accidental details of one observation."
        },
        {
          "audio_slot_id": "audio-pending-ac1c6acc2e3b2775",
          "cast_id": "narrator",
          "id": "line-shot-5-3-2",
          "source_sentence_ids": [
            "ac1c6acc2e3b2775"
          ],
          "text": "The price is that the model must choose which entities and edges deserve attention."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "background_intent": {
        "kind": "gradient",
        "stops": [
          {
            "color": "#020617",
            "offset": 0
          },
          {
            "color": "#14b8a6",
            "offset": 1
          }
        ]
      },
      "duration_estimate_s": 7,
      "kind": "narrator-opener",
      "scene_eyebrow": "Learned Dynamics",
      "scene_title": "Messages As Physics",
      "shot_address": {
        "scene_id": "scene-message-passing-physics",
        "shot_id": "shot-6-1"
      },
      "source_beat_id": "beat-message-passing-physics-01",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-893fafccd1167f10",
          "cast_id": "narrator",
          "id": "line-shot-6-1-1",
          "source_sentence_ids": [
            "893fafccd1167f10"
          ],
          "text": "In a graph dynamics model, prediction begins with object states and an action that may affect one object or the whole scene."
        }
      ],
      "transition_in": {
        "duration_ms": 600,
        "kind": "cross-dissolve"
      }
    },
    {
      "duration_estimate_s": 10,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-message-passing-physics",
        "shot_id": "shot-6-2"
      },
      "source_beat_id": "beat-message-passing-physics-02",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-fb76c8d8fa66e005",
          "cast_id": "narrator",
          "id": "line-shot-6-2-1",
          "source_sentence_ids": [
            "fb76c8d8fa66e005"
          ],
          "text": "Each node sends messages along its edges that describe how it may influence its neighbors."
        },
        {
          "audio_slot_id": "audio-pending-d64319b617f9ede3",
          "cast_id": "narrator",
          "id": "line-shot-6-2-2",
          "source_sentence_ids": [
            "d64319b617f9ede3"
          ],
          "text": "A receiving node aggregates those messages with its own state and the action context."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 4,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-message-passing-physics",
        "shot_id": "shot-6-3"
      },
      "source_beat_id": "beat-message-passing-physics-03",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-9298caa4b524616e",
          "cast_id": "narrator",
          "id": "line-shot-6-3-1",
          "source_sentence_ids": [
            "9298caa4b524616e"
          ],
          "text": "The shared dynamics rule updates every object into a predicted next state."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "duration_estimate_s": 6,
      "kind": "narrative",
      "shot_address": {
        "scene_id": "scene-message-passing-physics",
        "shot_id": "shot-6-4"
      },
      "source_beat_id": "beat-message-passing-physics-04",
      "speakers": [
        "narrator"
      ],
      "spoken_lines": [
        {
          "audio_slot_id": "audio-pending-817c59e419365f29",
          "cast_id": "narrator",
          "id": "line-shot-6-4-1",
          "source_sentence_ids": [
            "817c59e419365f29"
          ],
          "text": "Message passing acts like learned local physics because future motion emerges from repeated object-to-object influence."
        }
      ],
      "transition_in": {
        "duration_ms": 0,
        "kind": "cut"
      }
    },
    {
      "background_intent": {
        "kind": "gradient",
        "stops": [
